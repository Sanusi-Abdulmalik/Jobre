# Jobre — Environment Configuration Template
# Copy to .env and customize before deployment. Never commit production secrets.

JOBRE_ENV=development
JOBRE_APP_NAME=Jobre
JOBRE_API_V1_PREFIX=/api/v1

# Primary Source-of-Truth Database (PostgreSQL 17+)
DATABASE_URL=postgresql+psycopg://jobre@127.0.0.1:5432/jobre
TEST_DATABASE_URL=postgresql+psycopg://jobre@127.0.0.1:5432/jobre_test
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25

# Redis Queue & Distributed Locks
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# Search Projection (OpenSearch 2.x with automatic PostgreSQL FTS hot-fallback)
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=jobre_jobs_v1

# Raw Snapshot Object Storage (Local compressed store or S3/MinIO)
RAW_STORAGE_BACKEND=local
RAW_STORAGE_PATH=/home/user/jobre/data/raw_snapshots
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=jobre-raw-snapshots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme_in_production

# Administrative Authentication
# Required via X-Admin-Key header or Authorization: Bearer <token> for /api/v1/admin/*
JOBRE_ADMIN_API_KEY=jobre-dev-admin-key-change-in-prod

# HTTP Collection & Responsible Crawling
JOBRE_USER_AGENT=JobreBot/1.0 (+https://github.com/Sanusi-Abdulmalik/jobre)
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
DEFAULT_RATE_LIMIT_RPM=30
ALLOW_PRIVATE_NETWORK_URLS=false

# Deduplication & Lifecycle Policy
DEDUP_AUTO_MERGE_THRESHOLD=0.88
DEDUP_REVIEW_THRESHOLD=0.68
CLOSURE_MISSING_RUNS_THRESHOLD=2

# Frontend Proxy Target
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Jobre
